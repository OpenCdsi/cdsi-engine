<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AzureFunctionsVersion>v4</AzureFunctionsVersion>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>OpenCdsi.VaxEngine.Functions</RootNamespace>
    <LangVersion>12</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- ASP.NET Core-style HttpRequest/IActionResult integration for isolated-worker HTTP
         triggers, rather than the older HttpRequestData/HttpResponseData model - lets
         ForecastFunction.cs read the request body the same way OpenCdsi.VaxEngine.Api's own minimal API
         endpoint does, instead of a second, different HTTP-handling style for the same DTOs.
         Versions bumped for real, confirmed net10.0 compatibility when this project moved off
         net8.0 (Azure Functions .NET 10 isolated-worker support is GA as of Ignite 2025;
         Microsoft's own guidance is "SDK 2.0.0 or later" for .NET 9+, and these are the current
         published versions as of that search, not the original 2.0.0 baseline this project
         started with) - see README for the full account, including two real, currently-open
         GitHub issues about .NET 10 Azure Functions deployment that are worth knowing about
         before actually deploying, not just building locally. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker" Version="2.52.0" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Http.AspNetCore" Version="2.1.1" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Sdk" Version="2.0.7">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenCdsi.VaxEngine.Core\OpenCdsi.VaxEngine.Core.csproj" />
    <ProjectReference Include="..\OpenCdsi.VaxEngine.Contracts\OpenCdsi.VaxEngine.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="host.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="local.settings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </None>
  </ItemGroup>

</Project>
