<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>OpenCdsi.VaxEngine.Api</RootNamespace>
    <LangVersion>12</LangVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Bumped from 6.6.2 to 10.2.3 as part of the net8.0 -> net10.0 move - this was NOT a
         simple version bump. 6.6.2 (the version originally, deliberately pinned for confirmed
         .NET 8 support) does not support .NET 10 at all: .NET 10's native OpenAPI generation
         moved to Microsoft.OpenApi v2.x, and Swashbuckle versions before the 10.x line are tied
         to Microsoft.OpenApi v1.x. 10.2.3 is Swashbuckle's own current, confirmed .NET
         10-compatible release - but real migrations report genuine breaking API changes between
         the 6.x and 10.x lines. This project's own Swagger usage (AddSwaggerGen/SwaggerDoc/
         UseSwagger/UseSwaggerUI) is about as simple as Swashbuckle usage gets, so it's likely
         unaffected - but that's reasoned from the surface area being simple, not confirmed
         against an actual build. See README for the full account, including whether the native
         Microsoft.AspNetCore.OpenApi package (which Microsoft itself has been steering people
         toward since .NET 9) might be worth considering as a replacement in its own right,
         separately from this .NET version migration. -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenCdsi.VaxEngine.Core\OpenCdsi.VaxEngine.Core.csproj" />
    <ProjectReference Include="..\OpenCdsi.VaxEngine.Contracts\OpenCdsi.VaxEngine.Contracts.csproj" />
  </ItemGroup>

</Project>
